\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Trecho inicial do panorama espacial reconstruído de um ensaio de \textit  {churn} (primeiras 900 colunas, de um total de 9586). A textura é densa e desorganizada, sem estruturas discretas bem definidas, refletindo o caráter agitado do regime.}}{45}{figure.4.10}\protected@file@percent }
\newlabel{fig:res-panorama-churn}{{10}{45}{Trecho inicial do panorama espacial reconstruído de um ensaio de \textit {churn} (primeiras 900 colunas, de um total de 9586). A textura é densa e desorganizada, sem estruturas discretas bem definidas, refletindo o caráter agitado do regime}{figure.4.10}{}}
