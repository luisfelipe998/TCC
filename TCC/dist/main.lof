\contentsline {figure}{\numberline {1}{\ignorespaces Esquema do arranjo experimental do LETEF: loop fechado com bomba de engrenagem magnética, \textit {subcooler}, medidor Coriolis, pré-aquecedor (PH), seção de teste (TS), seção de visualização (VS), condensador e reservatório.}}{21}{figure.2.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces Amostras de imagens dos cinco padrões de escoamento observados no arranjo experimental do LETEF: (a) bolha dispersa, (b) \textit {plug}, (c) \textit {slug}, (d) \textit {churn} e (e) anular ondulado.}}{25}{figure.2.2}%
\contentsline {figure}{\numberline {3}{\ignorespaces Padrão \textit {slug} — escalograma do WPS do sinal de pressão diferencial ($G = 510\,\text {kg/(m}^2\text {s)}$): energia concentrada abaixo de 1\,Hz, com componentes adicionais em torno de 2{,}8\,Hz no sensor óptico.}}{28}{figure.2.3}%
\contentsline {figure}{\numberline {4}{\ignorespaces Padrão \textit {churn} — escalograma do WPS do sinal de pressão diferencial ($G = 510\,\text {kg/(m}^2\text {s)}$): energia predominante em baixas frequências (abaixo de 8\,Hz) e de baixa amplitude no sinal de pressão diferencial.}}{29}{figure.2.4}%
\contentsline {figure}{\numberline {5}{\ignorespaces Padrão \textit {slug} — escalograma do WPS do sensor óptico ($G = 510\,\text {kg/(m}^2\text {s)}$): pico dominante em torno de 2{,}8\,Hz com harmônicos em frequências acima de 8\,Hz, gerados pelas bolhas dispersas intercaladas entre os bolsões de vapor.}}{29}{figure.2.5}%
\contentsline {figure}{\numberline {6}{\ignorespaces Padrão \textit {churn} — escalograma do WPS do sensor óptico ($G = 510\,\text {kg/(m}^2\text {s)}$): energia concentrada entre 15 e 28\,Hz, faixa significativamente mais alta do que a observada no sinal de pressão diferencial do mesmo padrão (abaixo de 8\,Hz).}}{30}{figure.2.6}%
\contentsline {figure}{\numberline {7}{\ignorespaces Fluxograma do método para caracterização dos padrões de escoamento por coerência \textit {Wavelet} alternativa a partir de sinais espaciais de brilho.}}{35}{figure.3.7}%
\contentsline {figure}{\numberline {8}{\ignorespaces Trecho inicial do panorama espacial reconstruído de um ensaio de \textit {plug} (primeiras 900 colunas, de um total de 5940). O eixo horizontal corresponde à posição ao longo do percurso do escoamento; bolhas alongadas discretas alternam-se com trechos de líquido mais uniformes.}}{44}{figure.4.8}%
\contentsline {figure}{\numberline {9}{\ignorespaces Trecho inicial do panorama espacial reconstruído de um ensaio de \textit {slug} (primeiras 900 colunas, de um total de 5071). As bolhas alongadas são mais longas e mais frequentes do que no \textit {plug}, mantido o fundo de líquido entre elas.}}{45}{figure.4.9}%
\contentsline {figure}{\numberline {10}{\ignorespaces Trecho inicial do panorama espacial reconstruído de um ensaio de \textit {churn} (primeiras 900 colunas, de um total de 9586). A textura é densa e desorganizada, sem estruturas discretas bem definidas, refletindo o caráter agitado do regime.}}{45}{figure.4.10}%
\contentsline {figure}{\numberline {11}{\ignorespaces Trecho inicial do panorama espacial reconstruído de um ensaio de anular ondulado (primeiras 900 colunas, de um total de 23079). Um filme contínuo recobre a parede e a interface exibe uma ondulação fina e regular ao longo do percurso.}}{45}{figure.4.11}%
\contentsline {figure}{\numberline {12}{\ignorespaces Sinais espaciais de brilho de dois ensaios de \textit {churn}, na variante \textit {cropped} (média das linhas 20 a 59 do panorama), após pré-processamento. Painéis superior e central: cada ensaio isoladamente. Painel inferior: os dois sinais sobrepostos, em unidades de desvio padrão, ao longo da posição em pixels.}}{46}{figure.4.12}%
\contentsline {figure}{\numberline {13}{\ignorespaces Sinais espaciais de brilho de dois ensaios de anular ondulado, na variante \textit {cropped}. Mesma disposição de painéis da \autoref {fig:res-sinais}.}}{47}{figure.4.13}%
\contentsline {figure}{\numberline {14}{\ignorespaces Sinais espaciais de brilho de dois ensaios de \textit {plug}, na variante \textit {cropped}. Mesma disposição de painéis da \autoref {fig:res-sinais}.}}{48}{figure.4.14}%
\contentsline {figure}{\numberline {15}{\ignorespaces Sinais espaciais de brilho de dois ensaios de \textit {slug}, na variante \textit {cropped}. Mesma disposição de painéis da \autoref {fig:res-sinais}.}}{49}{figure.4.15}%
\contentsline {figure}{\numberline {16}{\ignorespaces Campos espectrais de um par de ensaios de \textit {churn} (variante \textit {cropped}). Linha superior: espectro de potência $\widetilde {P}_x$ e $\widetilde {P}_y$ de cada ensaio, com o respectivo perfil de potência média $|\text {WPS}|$ ao lado. Linha central: espectro cruzado $\widetilde {C}_{xy}$. Linha inferior: coerência $\widetilde {\gamma }_{xy}$. Eixo vertical em comprimento de onda (pixels), eixo horizontal em atraso (pixels).}}{50}{figure.4.16}%
\contentsline {figure}{\numberline {17}{\ignorespaces Campos espectrais de um par de ensaios de anular ondulado (variante \textit {cropped}). Mesma disposição de painéis da \autoref {fig:res-wps}. O perfil de potência média concentra o máximo na faixa mais estreita e curta entre os padrões.}}{51}{figure.4.17}%
\contentsline {figure}{\numberline {18}{\ignorespaces Campos espectrais de um par de ensaios de \textit {plug} (variante \textit {cropped}). Mesma disposição de painéis da \autoref {fig:res-wps}.}}{52}{figure.4.18}%
\contentsline {figure}{\numberline {19}{\ignorespaces Campos espectrais de um par de ensaios de \textit {slug} (variante \textit {cropped}). Mesma disposição de painéis da \autoref {fig:res-wps}.}}{53}{figure.4.19}%
\contentsline {figure}{\numberline {20}{\ignorespaces Campos espectrais de um par inter-padrão, um ensaio de \textit {churn} e um de anular ondulado (variante \textit {cropped}). Mesma disposição de painéis da \autoref {fig:res-wps}. Os perfis de potência média apresentam faixas dominantes parcialmente sobrepostas entre os dois padrões.}}{54}{figure.4.20}%
\contentsline {figure}{\numberline {21}{\ignorespaces Matriz de distância espectral ($1$ menos a correlação de Pearson entre os perfis de potência branqueados) entre os vinte e seis ensaios, ordenados por padrão (\textit {churn}, ensaios 1 a 10; anular ondulado, 11 a 19; \textit {plug}, 20 a 23; \textit {slug}, 24 a 26). Cores mais claras indicam ensaios mais parecidos; as linhas brancas separam os quatro padrões, e os blocos na diagonal correspondem a pares de um mesmo padrão. A cruz escura no ensaio 21 (um \textit {plug}) assinala um ensaio de assinatura atípica, anticorrelacionado com quase todos os demais.}}{56}{figure.4.21}%
\contentsline {figure}{\numberline {22}{\ignorespaces Distribuição acumulada (ECDF) das distâncias espectrais entre ensaios: dentro de um mesmo padrão (\textit {intra}, noventa pares) e entre padrões distintos (\textit {inter}, duzentos e trinta e cinco pares). A curva intra-padrão, deslocada para a esquerda, traduz a separação sutil quantificada por $R = 0{,}20$.}}{58}{figure.4.22}%
